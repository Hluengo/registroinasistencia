    "@tanstack/react-query": "^5.90.21",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "express-timeout-handler": "^2.2.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
