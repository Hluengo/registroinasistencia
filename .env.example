# Frontend-safe environment variables (Vite)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
VITE_SUPABASE_AUTH_STORAGE_KEY=registroinasistencia-auth-token
# Legacy fallback only:
# VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Optional when API is hosted on another domain in production
# VITE_API_BASE_URL=https://your-api-domain.com

# Backend-only secrets (do not expose with VITE_ prefix)
GEMINI_API_KEY=your-gemini-api-key
PORT=8787
